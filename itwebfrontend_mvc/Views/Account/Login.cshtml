@model LoginViewModel
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LIBRARY HUB | Đăng nhập</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-brand">
            <span class="brand-icon" aria-hidden="true">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/></svg>
            </span>
            <b>LIBRARY HUB</b>
        </div>
        <h1>Đăng nhập</h1>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="form-grid single">
                <label class="field">
                    <span>Email</span>
                    <input asp-for="Email" type="email" autocomplete="username" required />
                    <span class="field-error" asp-validation-for="Email"></span>
                </label>
                <label class="field">
                    <span>Mật khẩu</span>
                    <input asp-for="Password" type="password" autocomplete="current-password" required />
                    <span class="field-error" asp-validation-for="Password"></span>
                </label>
                <label class="field check">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
            </div>
            <div class="form-actions">
                <button class="primary" type="submit">Đăng nhập</button>
            </div>
        </form>
    </div>
</body>
</html>
