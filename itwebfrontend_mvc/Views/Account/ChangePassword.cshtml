@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }

<div class="section-heading"><h2>Đổi mật khẩu</h2></div>

<div class="panel form-page">
    <form asp-action="ChangePassword" method="post">
        <div class="form-grid">
            <label class="field">
                <span>Mật khẩu hiện tại</span>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
                <span class="field-error" asp-validation-for="CurrentPassword"></span>
            </label>
            <label class="field">
                <span>Mật khẩu mới</span>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
                <span class="field-error" asp-validation-for="NewPassword"></span>
            </label>
            <label class="field">
                <span>Nhập lại mật khẩu mới</span>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
                <span class="field-error" asp-validation-for="ConfirmPassword"></span>
            </label>
        </div>
        <div class="form-actions">
            <button class="primary" type="submit">Lưu mật khẩu</button>
            <a class="small-btn" asp-action="Profile">Hủy</a>
        </div>
    </form>
</div>
