@model BookListViewModel
@{
    ViewData["Title"] = "Quản lý sách";
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="section-heading">
    <h2>@(isAdmin ? "Quản lý sách" : "Danh mục sách")</h2>
    @if (isAdmin)
    {
        <a class="primary" asp-action="Create">+ Thêm sách</a>
    }
</div>

<div class="panel">
    <!-- Bộ lọc: từ khóa + thể loại + tác giả (gửi GET; đổi ô chọn là tự lọc) -->
    <form class="filter-bar" asp-action="Index" method="get">
        <input name="q" aria-label="Tìm sách" placeholder="Tìm theo tên, tác giả..." value="@Model.Query" data-filter="#bookTable" />

        <label class="filter-field">
            <span>Thể loại</span>
            <select name="category" data-autosubmit data-reset="#authorSelect">
                <option value="">Tất cả thể loại</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(string.Equals(c, Model.Category, StringComparison.OrdinalIgnoreCase))">@c</option>
                }
            </select>
        </label>

        <label class="filter-field">
            <span>Tác giả</span>
            <select name="author" id="authorSelect" data-autosubmit>
                <option value="">Tất cả tác giả</option>
                @foreach (var au in Model.Authors)
                {
                    <option value="@au" selected="@(string.Equals(au, Model.Author, StringComparison.OrdinalIgnoreCase))">@au</option>
                }
            </select>
        </label>

        <button class="small-btn" type="submit">Lọc</button>
        @if (Model.HasFilter)
        {
            <a class="small-btn" asp-action="Index">Xóa lọc</a>
        }
        <span class="muted filter-count">@Model.Items.Count đầu sách</span>
    </form>

    <div class="table-wrap">
        <table id="bookTable">
            <thead>
                <tr>
                    <th>Mã</th><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>Số lượng</th>
                    @if (isAdmin) { <th>Thao tác</th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model.Items)
            {
                <tr>
                    <td>#@b.Id</td>
                    <td>
                        <div class="title-cell">
                            <img class="thumb" src="@b.CoverUrl" alt="Bìa sách @b.Title" loading="lazy" />
                            <b>@b.Title</b>
                        </div>
                    </td>
                    <td><a class="filter-link" asp-action="Index" asp-route-author="@b.Author" title="Lọc theo tác giả này">@b.Author</a></td>
                    <td><a class="tag filter-link" asp-action="Index" asp-route-category="@b.Category" title="Lọc theo thể loại này">@b.Category</a></td>
                    <td>@b.Quantity</td>
                    @if (isAdmin)
                    {
                        <td>
                            <div class="actions">
                                <a class="small-btn" asp-controller="Books" asp-action="Edit" asp-route-id="@b.Id">Sửa</a>
                                <form class="inline-form" asp-controller="Books" asp-action="Delete" asp-route-id="@b.Id" method="post" data-confirm="Bạn chắc chắn muốn xóa?">
                                    <button class="small-btn danger" type="submit">Xóa</button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="@(isAdmin ? 6 : 5)" class="empty">Chưa có dữ liệu phù hợp</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
