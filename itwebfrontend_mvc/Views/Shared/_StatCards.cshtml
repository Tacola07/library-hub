@model LibraryStats
@* 4 thẻ thống kê — dùng ở Trang chủ và Thống kê (model: LibraryStats). *@
<div class="stats">
    <div class="stat">
        <span class="ico">▣</span>
        <div><small>Tổng số sách</small><strong>@Model.TotalBooks</strong></div>
    </div>
    <div class="stat">
        <span class="ico"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <div><small>Tổng số độc giả</small><strong>@Model.TotalReaders</strong></div>
    </div>
    <div class="stat">
        <span class="ico">⇄</span>
        <div><small>Đang mượn</small><strong>@Model.Borrowing</strong></div>
    </div>
    <div class="stat warn">
        <span class="ico">▤</span>
        <div><small>Quá hạn</small><strong>@Model.Overdue</strong></div>
    </div>
</div>
